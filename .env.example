# Postgres connection string (Neon, Supabase "connection pooling" URL, or any Postgres 14+).
# Leave empty for local development: an embedded PGlite database is stored in .data/pglite.
DATABASE_URL=

# First-run staff accounts. Created only when no staff exist yet. Min 8 characters.
# Run `pnpm setup:local` to generate random values into .env.local.
BOOTSTRAP_LEAD_USERNAME=lead
BOOTSTRAP_LEAD_PASSWORD=
BOOTSTRAP_BARISTA_USERNAME=barista
BOOTSTRAP_BARISTA_PASSWORD=

# Protects /api/cron/maintenance (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# Optional
# NAME_RETENTION_MINUTES=15     # purge first names this long after collection
# SEED_SAMPLE_MENU=false        # skip the sample menu on an empty database
# DISABLE_DATA_RESET=true       # lock "reset test data" during the live event
